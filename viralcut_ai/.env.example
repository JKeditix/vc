# VIRALCUT AI Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env!

PROJECT_NAME=VIRALCUT AI
HOST=0.0.0.0
PORT=8000

# Optional: Google Gemini API Key for AI viral scoring, copywriting & audio transcription
GEMINI_API_KEY=freellmapi-ba9cb018c22b4322fa8d74d07757433fd60e73d48fd752f6
GEMINI_MODEL=gemini-2.5-flash

# Local speech-to-text model (faster-whisper): tiny, base, small, medium
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Storage and Database
STORAGE_DIR=./viralcut_storage
DATABASE_URL=
MAX_UPLOAD_MB=2048
